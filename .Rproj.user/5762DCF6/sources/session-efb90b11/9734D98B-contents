  \pgfmathsetmacro{\pone}{1/(1+exp(-\aone*(\t-\bone)))}
  \pgfmathsetmacro{\ptwo}{1/(1+exp(-\atwo*(\t-\btwo)))}
  \pgfmathsetmacro{\pmax}{max(\pone,\ptwo)}
  \draw[dashed, semithick, person] (\t*\xs,0) -- (\t*\xs,\pmax*\ys);
  \draw[dashed, semithick, itemone] (-5.2*\xs,\pone*\ys) -- (\t*\xs,\pone*\ys);
  \draw[dashed, semithick, itemtwo] (-5.2*\xs,\ptwo*\ys) -- (\t*\xs,\ptwo*\ys);
}

% Item characteristic curves
\draw[thick, itemone, domain=-5:5, samples=120, smooth]
  plot ({\x*\xs}, {\ys/(1+exp(-\aone*(\x-\bone)))});
\draw[thick, itemtwo, domain=-5:5, samples=120, smooth]
