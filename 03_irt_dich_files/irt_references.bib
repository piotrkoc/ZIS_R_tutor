@article{reiseMatchingIRTModels2021,
  title = {Matching {{IRT Models}} to {{Patient-Reported Outcomes Constructs}}: {{The Graded Response}} and {{Log-Logistic Models}} for {{Scaling Depression}}},
  shorttitle = {Matching {{IRT Models}} to {{Patient-Reported Outcomes Constructs}}},
  author = {Reise, Steven P. and Du, Han and Wong, Emily F. and Hubbard, Anne S. and Haviland, Mark G.},
  date = {2021-09},
  journaltitle = {Psychometrika},
