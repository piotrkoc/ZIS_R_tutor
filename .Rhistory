library(lavaan)
# define model structure of CFA model:
SEM_2PL_model <- '
theta =~ NA*Eco_aff_1_dicho + Eco_aff_2_dicho + Eco_aff_3_dicho + Eco_cog_4_dicho +
Eco_cog_5_dicho + Eco_cog_6_dicho + Eco_con_7_dicho + Eco_con_8_dicho + Eco_con_9_dicho
theta ~~ 1*theta
'
# estimate CFA model
cfa_2PL <- cfa(SEM_2PL_model, data = dat_eco_dicho[12:20],
ordered = names(dat_eco_dicho[12:20]),   # Items als kategorial
std.lv = TRUE,          # Faktorvarianz = 1 (wie in IRT)
estimator = "WLSMV")
# extract model parameters
standardizedSolution(cfa_2PL)          # loaings (=~) and thresholds (|)
# oder kompakt:
lambda_sem <- inspect(cfa_2PL, "std")$lambda
compare_loadings <- as.data.frame(cbind(lambda_sem, loadings_2PL$rotF))
names(compare_loadings) <- c("CFA", "IRT")
