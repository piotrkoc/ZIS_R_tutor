library(lavaan)
# define model structure of CFA model:
SEM_2PL_model <- '
theta =~ NA*Eco_aff_1_dicho + Eco_aff_2_dicho + Eco_aff_3_dicho + Eco_cog_4_dicho +
Eco_cog_5_dicho + Eco_cog_6_dicho + Eco_con_7_dicho + Eco_con_8_dicho + Eco_con_9_dicho
theta ~~ 1*theta
'
# estimate CFA model
cfa_2PL <- cfa(SEM_2PL_model, data = dat_eco_dicho[12:20],
ordered = names(dat_eco_dicho[12:20]),   # Items als kategorial
std.lv = TRUE,          # Faktorvarianz = 1 (wie in IRT)
estimator = "WLSMV")
# extract model parameters
standardizedSolution(cfa_2PL)          # loaings (=~) and thresholds (|)
# oder kompakt:
lambda_sem <- inspect(cfa_2PL, "std")$lambda
compare_loadings <- as.data.frame(cbind(lambda_sem, loadings_2PL$rotF))
names(compare_loadings) <- c("CFA", "IRT")
compare_loadings
round(standardizedSolution(cfa_2PL),2)          # loaings (=~) and thresholds (|)
# oder kompakt:
lambda_sem <- inspect(cfa_2PL, "std")$lambda
lambda_sem
coef(eco_2PL)
coef(eco_2PL, IRTpars=TRUE, simplify=TRUE)$items[,1]
coef(eco_2PL, IRTpars=TRUE, simplify=TRUE)
# compare loading estimates from CFA model (lavaan) with IRT (mirt)
compare_loadings <- as.data.frame(cbind(lambda_sem, loadings_2PL$rotF))
names(compare_loadings) <- c("lambdas_CFA", "lambdas_IRT")
compare_loadings
# alpha parameters from mirt
alphas_irt <- coef(eco_2PL, IRTpars=TRUE, simplify=TRUE)$items[,1]
# factor loadings from the CFA
lambdas <- compare_loadings$CFA
# transform loadings in discrimination parameters
alpha_CFA <- 1.702 * lambdas / sqrt(1 - lambdas^2)
# compare the parameters with each other
compare_loadings <- cbind(compare_loadings, alpha_CFA, alphas_irt)
View(dat_eco_dicho[12:20])
